# Copy to .env and fill in. The API runs without this file in development — see below.

# Port the API listens on.
PORT=4000

# Shared secret used to verify the HMAC signature on inbound SAP webhooks.
#
# Required whenever NODE_ENV is anything other than "development" or "test": with an unset or
# unrecognised NODE_ENV the server refuses to start rather than fall back, so a production box
# that forgot to set NODE_ENV can't silently accept the publicly-known development secret.
#
# In development and test it falls back to "dev-secret" with a warning, so `npm run dev` and
# `npm test` need no configuration at all.
SAP_WEBHOOK_SECRET=change-me

# Set explicitly when deploying. Anything other than development/test enforces the secret.
# NODE_ENV=production
