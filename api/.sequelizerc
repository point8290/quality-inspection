const path = require('path');

// Tells sequelize-cli where our files live, so migrations/seeders stay at the project
// root while the application code stays under src/.
module.exports = {
  config: path.resolve(__dirname, 'config', 'config.js'),
  'models-path': path.resolve(__dirname, 'src', 'models'),
  'migrations-path': path.resolve(__dirname, 'migrations'),
  'seeders-path': path.resolve(__dirname, 'seeders'),
};
